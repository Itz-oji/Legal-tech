# Copia este archivo como ".env" y completa los valores. Nunca subas ".env" a GitHub.
# Usa solo letras y números en POSTGRES_PASSWORD (va dentro de una URL).
POSTGRES_PASSWORD=
# Texto largo y aleatorio, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Opcional: habilita /api/admin/* (publicar criterios, sincronizar fuentes, correr alertas)
ADMIN_TOKEN=
# Opcional: correo para las alertas (sin SMTP_HOST no se envían)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
